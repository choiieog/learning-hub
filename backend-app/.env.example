# Backend environment variables — copy to .env and fill real values
PORT=3000
CORS_ORIGIN=http://localhost:4200
# Frontend origin, used to build the email verification link
APP_URL=http://localhost:4200

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/learning_hub?schema=public"

# JWT
JWT_ACCESS_SECRET=change-me-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-another-random-string
JWT_REFRESH_TTL=7d

# Account verification email: console = log the link (dev), smtp = real delivery via nodemailer
MAIL_DRIVER=console
MAIL_FROM="Learning Hub <no-reply@learninghub.local>"
# Only needed when MAIL_DRIVER=smtp — thiếu SMTP_HOST thì backend báo lỗi ngay lúc khởi động
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false        # true cho cổng 465 (SSL); 587 dùng STARTTLS
# SMTP_USER=
# SMTP_PASS=               # Gmail: App Password (bật 2FA), không phải mật khẩu đăng nhập

# Rate limit theo IP (số request / số phút) cho các route chống spam
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MIN=5
RATE_LIMIT_FORGOT_MAX=5
RATE_LIMIT_FORGOT_WINDOW_MIN=15
RATE_LIMIT_DOCUMENT_MAX=10
RATE_LIMIT_DOCUMENT_WINDOW_MIN=60
# Bật khi chạy sau reverse proxy để Express đọc IP thật từ X-Forwarded-For
TRUST_PROXY=false

# File storage: only "local" is implemented (writes to UPLOAD_DIR, served at /api/files/...).
# cloudinary | s3 fail fast at bootstrap until a driver is added in src/infra/storage/drivers.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20

# Only needed once a cloudinary driver exists
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
