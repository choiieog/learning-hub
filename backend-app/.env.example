# Backend environment variables — copy to .env and fill real values
PORT=3000
CORS_ORIGIN=http://localhost:4200
# Frontend origin, used to build the email verification link
APP_URL=http://localhost:4200

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/learning_hub?schema=public"
# E2E tự dùng database riêng `<DATABASE_URL database>_test`; đặt biến này để chọn database khác.
# E2E_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/learning_hub_test?schema=public"

# JWT
JWT_ACCESS_SECRET=change-me-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-another-random-string
JWT_REFRESH_TTL=7d

# Account verification email: console = log the link (dev), smtp = real delivery via nodemailer
MAIL_DRIVER=console
MAIL_FROM="Learning Hub <no-reply@learninghub.local>"
# Only needed when MAIL_DRIVER=smtp — thiếu SMTP_HOST thì backend báo lỗi ngay lúc khởi động
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false        # true cho cổng 465 (SSL); 587 dùng STARTTLS
# SMTP_USER=
# SMTP_PASS=               # Gmail: App Password (bật 2FA), không phải mật khẩu đăng nhập

# Rate limit theo IP (số request / số phút) cho các route chống spam
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MIN=5
# Đăng ký gửi email xác thực + gửi lại email → chặn spam
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_MIN=60
RATE_LIMIT_RESEND_MAX=3
RATE_LIMIT_RESEND_WINDOW_MIN=15
RATE_LIMIT_FORGOT_MAX=5
RATE_LIMIT_FORGOT_WINDOW_MIN=15
RATE_LIMIT_DOCUMENT_MAX=10
RATE_LIMIT_DOCUMENT_WINDOW_MIN=60
# Bật khi chạy sau reverse proxy để Express đọc IP thật từ X-Forwarded-For
TRUST_PROXY=false

# File storage: only "local" is implemented (writes to UPLOAD_DIR, served at /api/files/...).
# cloudinary | s3 fail fast at bootstrap until a driver is added in src/infra/storage/drivers.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20

# Rate limit dùng Redis khi chạy nhiều instance (bỏ trống = đếm trong RAM của process)
# REDIS_URL=redis://localhost:6379

# Chính sách lưu trữ cho dữ liệu phình theo thời gian — chạy hằng ngày: npm run db:prune
# DocumentView: mỗi lượt xem/ngày = 1 dòng
DOCUMENT_VIEW_RETENTION_DAYS=180
# File đã upload nhưng không gắn tài liệu nào (bỏ ngang) hoặc avatar đã bị thay
UPLOAD_ORPHAN_RETENTION_DAYS=7
# Thông báo chung (broadcast) cũ hơn mốc này bị xoá kèm trạng thái đọc của từng user
NOTIFICATION_READ_RETENTION_DAYS=180
# Thông báo cá nhân **đã đọc** cũ hơn mốc này (tin chưa đọc thì luôn giữ)
PERSONAL_NOTIFICATION_RETENTION_DAYS=180
# Sổ đối soát EXP — điểm/level nằm ở User nên xoá log không ảnh hưởng số của ai
EXP_LOG_RETENTION_DAYS=180

# Only needed once a cloudinary driver exists
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
